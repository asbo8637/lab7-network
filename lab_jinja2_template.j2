hostname {{ hostname }}

interface Loopback1
 ip address {{ loopback_ip }} 255.255.255.255
 no shutdown

interface FastEthernet0/0
 ip address {{ int00_ip }} 255.255.255.0
 no shutdown

interface FastEthernet1/0
 ip address {{ int10_ip }} 255.255.255.0
 no shutdown

{% if int20_ip %}
interface FastEthernet2/0
 ip address {{ int20_ip }} 255.255.255.0
 no shutdown
{% endif %}

router ospf {{ ospf_process }}
 network {{ loopback_ip }} 0.0.0.0 area {{ ospf_area }}
 network 198.51.100.0 0.0.0.255 area {{ ospf_area }}

{% if int10_ip == "198.51.101.3" or int10_ip == "198.51.101.4" %}
 network 198.51.101.0 0.0.0.255 area {{ ospf_area }}
{% endif %}

{% if int10_ip == "198.51.102.5" or int20_ip == "198.51.102.3"%}
 network 198.51.102.0 0.0.0.255 area {{ ospf_area }}
{% endif %}